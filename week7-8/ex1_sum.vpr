// =====================================================================
// Seminar 4 - Exercise 1: recursive sum of the first n natural numbers
// =====================================================================
//
// Task:
//   - write a recursive method sum that yields 0 + 1 + ... + n
//   - provide a suitable specification
//   - check that the specification is strong enough by verifying main()
//
// Method used (Lecture 7 - Procedures):
//   * Body check : assume requires; run the body; assert ensures.
//   * Call check : assert requires[n -> arg]; havoc result;
//                  assume ensures[n -> arg, s -> result].
//   * Recursion  : at the recursive call we may already ASSUME the
//                  postcondition we are proving (induction on calls).
//   * Termination: a variant that is >= 0 and smaller at every call.
//
// ---------------------------------------------------------------------
// Step 1 - What should the method compute?
//
//   sum(0) = 0
//   sum(n) = sum(n - 1) + n          for n >= 1
//
//   Small table, to find the closed form (Gauss):
//
//      n      | 0 | 1 | 2 | 3 | 4  | 10
//      sum(n) | 0 | 1 | 3 | 6 | 10 | 55
//      n(n+1) | 0 | 2 | 6 | 12| 20 | 110      -> always 2 * sum(n)
//
//   So  2 * sum(n) == n * (n + 1).
//
// Step 2 - Precondition (caller's duty).
//   "First n natural numbers" only makes sense for n >= 0. For n < 0
//   the recursion n, n-1, n-2, ... would never reach the base case 0,
//   so we exclude those inputs:          requires 0 <= n
//
// Step 3 - Postcondition (method's promise).
//   Why not something weak such as  ensures s >= 0 ?
//   Lecture 7 ("A weak contract hides information"): the client only
//   sees the contract. From s >= 0 the client could never conclude
//   r == 55 (r = 7 satisfies s >= 0 just as well).
//   So we give the EXACT value:          ensures 2 * s == n * (n + 1)
//
//   I write it with 2 * s instead of  s == n * (n + 1) \ 2  because it
//   avoids integer division: it is the same fact (n*(n+1) is always
//   even), but it is easier for the SMT solver and for a hand proof.
//
//   I also add  ensures s >= 0  - it is not needed by main(), but it
//   documents the result and is free to prove.
//
// Step 4 - Variant for termination:      decreases n
//   (1) bounded below: requires 0 <= n gives n >= 0
//   (2) smaller at the recursive call: n - 1 < n
// ---------------------------------------------------------------------

method sum(n: Int) returns (s: Int)
    requires 0 <= n
    ensures 2 * s == n * (n + 1)
    ensures s >= 0
    decreases n
{
    // Body check, as in Lecture 7:   assume 0 <= n
    if (n == 0) {
        s := 0
    // Base case (no recursive call, nothing assumed):
    //   2 * 0 == 0 * (0 + 1)   ->  0 == 0                OK
    //   0 >= 0                                           OK
    } else {
        // Here 0 <= n && n != 0, therefore n >= 1.
        //
        // Precondition of the recursive call: 0 <= n - 1,
        //   which holds because n >= 1.                      OK
        // Termination: variant at the call is n - 1 < n,
        //   and the caller's variant n >= 0.                 OK
        s := sum(n - 1)
        // Call encoding: assume the postcondition with n -> n - 1:
        //   2 * s == (n - 1) * n     and     s >= 0
        // (This is the induction hypothesis: the call has fewer
        //  nested calls than the current execution.)
        
        s := s + n
    // New s' = s + n, so
    //   2 * s' = 2 * s + 2n
    //          = (n - 1) * n + 2n
    //          = n^2 - n + 2n
    //          = n^2 + n
    //          = n * (n + 1)                             OK
    //   s' = s + n >= 0 + 1 >= 0                         OK
    }
// Both branches establish the postcondition -> body verified.
}

// ---------------------------------------------------------------------
// Client from the seminar. It is verified using ONLY the contract of
// sum, never its body (modular verification).
// ---------------------------------------------------------------------
method main() {
    var r: Int
    r := sum(10)
    // Encoding of the call (Lecture 7, "The encoding in one slide"):
    //   assert 0 <= 10                       // precondition      OK
    //   var r                                // forget r
    //   assume 2 * r == 10 * (10 + 1)        // postcondition
    //   assume r >= 0
    // so 2 * r == 110, hence r == 55.
    
    assert r == 55
// Verifies -> the specification is strong enough for this client.
}

// ---------------------------------------------------------------------
// Experiment (kept as a comment): with a weak contract the client fails.
//
//   method sum_weak(n: Int) returns (s: Int)
//       requires 0 <= n
//       ensures  s >= 0            // true, but too weak
//
//   r := sum_weak(10)
//   assert r == 55                 // "Assertion might not hold."
//
// The body would be exactly the same and correct; the client fails only
// because the contract hides the value of s. This is the check the
// exercise asks for: a spec is "strong enough" when the client verifies.
// ---------------------------------------------------------------------
