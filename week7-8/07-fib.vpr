function fib(n: Int): Int 
    //requires 0 <= n
{
    (n < 2) ? n : fib(n-2) + fib(n-1)
}

method iter_fib(n: Int) returns (res:Int)
    requires 0 <= n
    ensures res == fib(n)
{    
    res := 0
    var i: Int := 0
    var next: Int := 1

    while (i < n) 
        invariant 0 <= i && i <= n 
        invariant res == fib(i)
        invariant next == fib(i+1)
    {
        var t: Int := res
        res := next
        next := t + next
        i := i + 1
    }
}